+static bool UseZenDownloadsStaging() {
+  return Preferences::GetBool("zen.downloads.staging.enabled", false);
+}
+
+static Result<nsCOMPtr<nsIFile>, nsresult> GetZenDownloadsStagingDirectory() {
+#if defined(ANDROID)
+  return Err(NS_ERROR_FAILURE);
+#else
+  nsAutoString stagingPath;
+  nsresult rv =
+      Preferences::GetString("zen.downloads.staging.directory", stagingPath);
+  if (NS_FAILED(rv) || stagingPath.IsEmpty()) {
+    return GetOsTmpDownloadDirectory();
+  }
+
+  nsCOMPtr<nsIFile> dir = new nsLocalFile();
+  MOZ_TRY(dir->InitWithPath(stagingPath));
+  MOZ_TRY(EnsureDirectoryExists(dir));
+
+  return dir;
+#endif
+}
